{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "models/**",
          "src/**"
        ]
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "static/assets/$1"
    },
    {
      "src": "/logo.webp",
      "dest": "static/logo.webp"
    },
    {
      "src": "/favicon.ico",
      "dest": "static/favicon.png"
    },
    {
      "src": "/(.*)",
      "dest": "static/index.html"
    }
  ]
}
