{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "models/**",
          "src/**",
          "data/**"
        ]
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "static/assets/$1"
    },
    {
      "src": "/logo.webp",
      "dest": "static/logo.webp"
    },
    {
      "src": "/favicon.ico",
      "dest": "static/favicon.ico"
    },
    {
      "src": "/favicon.png",
      "dest": "static/favicon.png"
    },
    {
      "src": "/favicon.webp",
      "dest": "static/favicon.webp"
    },
    {
      "src": "/favicon-32x32.png",
      "dest": "static/favicon-32x32.png"
    },
    {
      "src": "/favicon-192x192.png",
      "dest": "static/favicon-192x192.png"
    },
    {
      "src": "/apple-touch-icon.png",
      "dest": "static/apple-touch-icon.png"
    },
    {
      "src": "/(.*)",
      "dest": "static/index.html"
    }
  ]
}
